# Everything here is read by Linux tools. Git on Windows would otherwise check
# these out with CRLF endings, and bash fails on the trailing carriage return
# with the famously unhelpful "$'\r': command not found". systemd is no kinder
# about unit files.
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.go        text eol=lf
go.mod      text eol=lf

# The Windows helper is the one file that genuinely wants CRLF.
*.cmd       text eol=crlf

# Week-0 evidence is a record; keep the bytes exactly as they were measured.
docs/week0-falsification/** -text

# Signed tree heads are signature-covered bytes, not text. Git must never
# translate a newline inside one: a head checked out with CRLF on Windows no
# longer matches what was signed, and the first person who tries to verify this
# log from a Windows clone would be told it is invalid. Treat them as binary.
heads/** -text
